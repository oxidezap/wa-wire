{
  "name": "@oxidezap/wa-wire-adapter-zapo",
  "version": "0.1.0",
  "description": "wa-wire adapter for the zapo engine",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/__tests__/**/*.test.ts\"",
    "test:coverage": "c8 --all --include \"src/**/*.ts\" --exclude \"src/**/__tests__/**\" --exclude \"src/**/types.ts\" --reporter text --check-coverage --lines 95 node --import tsx --test \"src/**/__tests__/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "zapo-js": ">=1.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "c8": "^10.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zapo-js": "file:../../../zapo"
  },
  "dependencies": {
    "@oxidezap/wa-wire-ts": "file:../typescript"
  }
}
